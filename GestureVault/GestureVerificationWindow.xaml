<Window
    x:Class="GestureVault.GestureVerificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GestureVault - Gesture Verification">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppBackgroundBrush}"
          RequestedTheme="Light">

        <Grid.Resources>
            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="48"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>

            <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="46"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource MutedButtonBorderBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource MutedButtonForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>
        </Grid.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Padding="20,18,20,24">
                <StackPanel x:Name="ContentStack"
                        HorizontalAlignment="Center"
                        Width="500"
                        MaxWidth="500"
                        Spacing="12">

                    <!-- Branding -->
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Border Width="46"
                                Height="46"
                                CornerRadius="18"
                                Background="{ThemeResource AccentBrush}">
                            <Viewbox Margin="12">
                                <TextBlock Text="🛡"
                                           Foreground="White"/>
                            </Viewbox>
                        </Border>

                        <TextBlock Text="GestureVault"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource PrimaryTextBrush}"/>

                        <TextBlock Text="Secure multi-modal digital vault"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <!-- Heading -->
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="Gesture Verification"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource PrimaryTextBrush}"/>

                        <TextBlock Text="Step 3 of 3 • Show your registered hand gesture"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="GestureStepText"
                                   Text="First gesture"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource AccentBrush}"/>
                    </StackPanel>

                    <!-- Gesture Card -->
                    <Border HorizontalAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="22"
                            Padding="22">

                        <StackPanel Spacing="12">

                            <!-- Camera Preview -->
                            <Border Height="220"
                                CornerRadius="22"
                                Background="#EAF2FF"
                                BorderBrush="{ThemeResource InputBorderBrush}"
                                BorderThickness="2">
                                <Grid>
                                    <!-- Actual camera feed -->
                                    <Image x:Name="CameraPreview"
                                        Stretch="Uniform"
                                        Height="220"/>

                                    <!-- Overlay when camera is off -->
                                    <StackPanel x:Name="CameraPlaceholder"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                        <TextBlock Text="✋"
                                            FontSize="46"
                                            TextAlignment="Center"/>

                                        <TextBlock x:Name="GestureStatusText"
                                            Text="Camera preview will appear here"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            TextAlignment="Center"
                                            Foreground="{ThemeResource PrimaryTextBrush}"/>

                                        <TextBlock Text="Place your hand inside the frame"
                                            FontSize="14"
                                            TextAlignment="Center"
                                            Foreground="{ThemeResource SecondaryTextBrush}"/>
                                    </StackPanel>

                                    <!-- Scan corner lines overlay -->
                                    <Border Width="46" Height="46"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="14"
                                        BorderBrush="{ThemeResource AccentBrush}"
                                        BorderThickness="4,4,0,0"
                                        CornerRadius="8,0,0,0"/>
                                    <Border Width="46" Height="46"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="14"
                                        BorderBrush="{ThemeResource AccentBrush}"
                                        BorderThickness="0,4,4,0"
                                        CornerRadius="0,8,0,0"/>
                                    <Border Width="46" Height="46"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="14"
                                        BorderBrush="{ThemeResource AccentBrush}"
                                        BorderThickness="4,0,0,4"
                                        CornerRadius="0,0,0,8"/>
                                    <Border Width="46" Height="46"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="14"
                                        BorderBrush="{ThemeResource AccentBrush}"
                                        BorderThickness="0,0,4,4"
                                        CornerRadius="0,0,8,0"/>
                                </Grid>
                            </Border>

                            <!-- Detection Info -->
                            <Border CornerRadius="18"
                                    BorderBrush="{ThemeResource InputBorderBrush}"
                                    BorderThickness="2"
                                    Background="{ThemeResource InputBackgroundBrush}"
                                    Padding="18,14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Detected gesture"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource SecondaryTextBrush}"/>

                                    <TextBlock x:Name="DetectedGestureText"
                                               Text="Waiting for hand gesture..."
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Border>


                            <Button x:Name="RedoGestureButton"
                                    Content="Redo Gesture"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    IsEnabled="False"
                                    Click="RedoGestureButton_Click"/>
                            <Button x:Name="NextGestureButton"
                                    Content="Next Gesture"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    IsEnabled="False"
                                    Click="NextGestureButton_Click"/>

                            <Button x:Name="StartCameraButton"
                                    Content="Start Camera"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Click="StartCameraButton_Click"/>

                            <Button x:Name="ShowHintButton"
                                    Content="Show Hint"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="ShowHintButton_Click"/>

                            <TextBlock Text="or"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                            <Button x:Name="SkipButton"
                                    Content="Skip (Demo Mode)"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="SkipButton_Click"/>

                            <Button x:Name="BackButton"
                                    Content="Back to Voice Step"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="BackButton_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
