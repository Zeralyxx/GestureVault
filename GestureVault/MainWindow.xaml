<Window
    x:Class="GestureVault.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GestureVault">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppBackgroundBrush}"
          RequestedTheme="Light">

        <Grid.Resources>
            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="56"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>

            <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="54"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource MutedButtonBorderBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource MutedButtonForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>
        </Grid.Resources>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContainer.Padding" Value="16,20,16,24"/>
                        <Setter Target="ContentStack.Width" Value="440"/>
                        <Setter Target="ContentStack.MaxWidth" Value="440"/>
                        <Setter Target="BrandIcon.Width" Value="52"/>
                        <Setter Target="BrandIcon.Height" Value="52"/>
                        <Setter Target="BrandTitle.FontSize" Value="34"/>
                        <Setter Target="BrandSubtitle.FontSize" Value="14"/>
                        <Setter Target="VaultTitle.FontSize" Value="38"/>
                        <Setter Target="LoginCard.Padding" Value="22"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContainer.Padding" Value="24,28,24,32"/>
                        <Setter Target="ContentStack.Width" Value="440"/>
                        <Setter Target="ContentStack.MaxWidth" Value="440"/>
                        <Setter Target="BrandIcon.Width" Value="60"/>
                        <Setter Target="BrandIcon.Height" Value="60"/>
                        <Setter Target="BrandTitle.FontSize" Value="42"/>
                        <Setter Target="BrandSubtitle.FontSize" Value="16"/>
                        <Setter Target="VaultTitle.FontSize" Value="50"/>
                        <Setter Target="LoginCard.Padding" Value="32"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid x:Name="PageContainer" Padding="24,28,24,32">
                <StackPanel x:Name="ContentStack"
                        HorizontalAlignment="Center"
                        Width="440"
                        MaxWidth="440"
                        Spacing="22">

                    <!-- Branding + Heading -->
                    <StackPanel HorizontalAlignment="Center"
                        MaxWidth="620"
                        Spacing="14">

                        <!-- Brand -->
                        <StackPanel HorizontalAlignment="Center"
                             Spacing="8">
                            <Border x:Name="BrandIcon"
                                Width="60"
                                Height="60"
                                CornerRadius="18"
                                Background="{ThemeResource AccentBrush}">
                                <Viewbox Margin="12">
                                    <TextBlock Text="🛡"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>
                                </Viewbox>
                            </Border>

                            <TextBlock x:Name="BrandTitle"
                               Text="GestureVault"
                               FontSize="42"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Foreground="{ThemeResource PrimaryTextBrush}"/>

                            <TextBlock x:Name="BrandSubtitle"
                               Text="Secure multi-modal digital vault"
                               FontSize="16"
                               TextAlignment="Center"
                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <!-- Main Heading -->
                        <StackPanel HorizontalAlignment="Center"
                            Spacing="6"
                            Margin="0,8,0,0">
                            <TextBlock x:Name="VaultTitle"
                               Text="Your vault is locked"
                               FontSize="50"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource PrimaryTextBrush}"/>

                            <TextBlock Text="Step 1 of 3 • Enter your master password"
                               FontSize="15"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- Login Card -->
                    <Border x:Name="LoginCard"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="28"
                            Padding="32">

                        <StackPanel Spacing="20">

                            <!-- Master Password -->
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryTextBrush}">
                                <Run Text="Master Password"/>
                                <Run Text=" (required)"
                                     Foreground="{ThemeResource SecondaryTextBrush}"/>
                                </TextBlock>

                                <Grid Height="60">
                                    <Grid.Resources>
                                        <!-- Remove default WinUI textbox/passwordbox surfaces -->
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>

                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                                    </Grid.Resources>

                                    <!-- Outer shell -->
                                    <Border CornerRadius="18"
                                        BorderBrush="{ThemeResource InputBorderBrush}"
                                        BorderThickness="2"
                                        Background="{ThemeResource InputBackgroundBrush}"/>

                                    <!-- Visible text version -->
                                    <TextBox x:Name="PasswordTextBox" IsReadOnly="True"
                                         Visibility="Collapsed"
                                         Height="28"
                                         Margin="18,0,60,0"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         FontSize="16"
                                         TextAlignment="Left"/>

                                    <!-- Hidden password version -->
                                    <PasswordBox x:Name="MasterPasswordBox"
                                         Height="28"
                                         Margin="18,0,60,0"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         FontSize="16"
                                         PasswordRevealMode="Hidden"/>

                                    <!-- Custom eye button -->
                                    <Button x:Name="TogglePasswordButton"
                                        Width="36"
                                        Height="36"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="TogglePasswordButton_Click">
                                        <TextBlock x:Name="EyeIcon" Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Button x:Name="ContinueButton"
                                    Content="Continue"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Click="ContinueButton_Click"/>

                            <Button x:Name="ShowHintButton"
                                    Content="Show Hint"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="ShowHintButton_Click"/>

                            <TextBlock Text="or"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>

                            <Button x:Name="ExitButton"
                                    Content="Exit Vault"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="ExitButton_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
