<Window
    x:Class="GestureVault.VaultDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GestureVault - Vault">

    <Grid Background="{ThemeResource AppBackgroundBrush}" RequestedTheme="Light">

        <Grid.Resources>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="46"/>
                <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="14"/>
            </Style>

            <Style x:Key="CardButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="42"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource MutedButtonBorderBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource MutedButtonForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius" Value="12"/>
            </Style>
        </Grid.Resources>

        <Grid Padding="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="52"
                            Height="52"
                            CornerRadius="16"
                            Background="{ThemeResource AccentBrush}">
                        <Viewbox Margin="12">
                            <TextBlock Text="🛡" Foreground="White"/>
                        </Viewbox>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GestureVault"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}"/>
                        <TextBlock Text="Your secure digital locker"
                                   FontSize="14"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Settings"
                        Width="120"
                        Margin="0,0,12,0"
                        Style="{StaticResource CardButtonStyle}"
                        Click="SettingsButton_Click"/>

                <Button Grid.Column="2"
                        Content="Lock Vault"
                        Width="120"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LockVaultButton_Click"/>
            </Grid>

            <!-- Main Dashboard -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="20">

                    <StackPanel Spacing="16">
                        <TextBlock Text="Vault Menu"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource PrimaryTextBrush}"/>

                        <Button Content="All Files"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="Passwords"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource CardButtonStyle}"/>

                        <Button Content="Secure Notes"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource CardButtonStyle}"/>

                        <Button Content="Documents"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource CardButtonStyle}"/>

                        <Button Content="Recovery Codes"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource CardButtonStyle}"/>

                        <Border Height="1"
                                Background="{ThemeResource CardBorderBrush}"
                                Margin="0,8"/>

                        <TextBlock Text="Vault Status"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>

                        <TextBlock Text="Unlocked"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AccentBrush}"/>

                        <TextBlock Text="Offline storage active"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Content Area -->
                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="24"
                        Padding="24">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Section Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Stored Vault Items"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource PrimaryTextBrush}"/>
                                <TextBlock Text="Manage your encrypted passwords, files, notes, and private records."
                                           FontSize="14"
                                           Foreground="{ThemeResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="+ Add Item"
                                    Width="130"
                                    Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>

                        <!-- Search Bar -->
                        <Border Grid.Row="1"
                                Height="52"
                                CornerRadius="16"
                                Margin="0,20,0,18"
                                BorderBrush="{ThemeResource InputBorderBrush}"
                                BorderThickness="2"
                                Background="{ThemeResource InputBackgroundBrush}">
                            <TextBox PlaceholderText="Search vault items..."
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="14,0"
                                     VerticalContentAlignment="Center"/>
                        </Border>


                        <!-- File Cards -->
                        <ScrollViewer Grid.Row="2">
                            <StackPanel Spacing="14">

                                <Border CornerRadius="18"
                                        BorderBrush="{ThemeResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="18"
                                        Background="{ThemeResource InputBackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="🔑"
                                                   FontSize="28"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,14,0"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Facebook Account"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Password • Last updated today"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Open"
                                                Width="90"
                                                Style="{StaticResource CardButtonStyle}"/>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="18"
                                        BorderBrush="{ThemeResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="18"
                                        Background="{ThemeResource InputBackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="📝"
                                                   FontSize="28"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,14,0"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Personal Secure Note"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Secure Note • Offline encrypted"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Open"
                                                Width="90"
                                                Style="{StaticResource CardButtonStyle}"/>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="18"
                                        BorderBrush="{ThemeResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="18"
                                        Background="{ThemeResource InputBackgroundBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="📄"
                                                   FontSize="28"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,14,0"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="School Document"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="File • Protected document"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Open"
                                                Width="90"
                                                Style="{StaticResource CardButtonStyle}"/>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <!-- Settings Popup Overlay -->
        <Grid x:Name="SettingsOverlay"
      Visibility="Collapsed"
      Background="#99000000">

            <Border Width="460"
            CornerRadius="28"
            Padding="28"
            Background="White"
            BorderBrush="{ThemeResource CardBorderBrush}"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel Spacing="20">

                    <TextBlock Text="Settings"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#1A1A1A"/>

                    <TextBlock Text="Manage your vault preferences."
                       FontSize="14"
                       Foreground="#667085"/>

                    <ToggleSwitch Header="Auto-lock vault"
                            IsOn="True"/>

                    <ComboBox Header="Auto-lock after"
                      SelectedIndex="1"
                      HorizontalAlignment="Stretch"
                      CornerRadius="12">
                        <ComboBoxItem Content="1 minute"/>
                        <ComboBoxItem Content="5 minutes"/>
                        <ComboBoxItem Content="10 minutes"/>
                        <ComboBoxItem Content="30 minutes"/>
                    </ComboBox>

                    <ToggleSwitch Header="Require gesture + voice every unlock"
                        IsOn="True"/>

                    <ToggleSwitch Header="Light mode (coming soon)"
                          IsOn="True"
                          IsEnabled="False"/>

                    <!-- Action Buttons -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Close -->
                        <Button Grid.Column="0"
                            Content="Close"
                            Height="48"
                            CornerRadius="16"
                            Background="Transparent"
                            BorderBrush="{ThemeResource MutedButtonBorderBrush}"
                            BorderThickness="2"
                            Foreground="{ThemeResource PrimaryTextBrush}"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            Click="CloseSettingsButton_Click"/>

                        <!-- Save -->
                        <Button Grid.Column="2"
                            Content="Save"
                            Height="48"
                            CornerRadius="16"
                            Background="{ThemeResource AccentBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Stretch"
                            Click="SaveSettingsButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>