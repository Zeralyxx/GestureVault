<Window
    x:Class="GestureVault.VoiceVerificationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GestureVault - Voice Verification">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppBackgroundBrush}"
          RequestedTheme="Light">

        <Grid.Resources>
            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="56"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>

            <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="54"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource MutedButtonBorderBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource MutedButtonForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>
        </Grid.Resources>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContainer.Padding" Value="16,20,16,24"/>
                        <Setter Target="ContentStack.Width" Value="440"/>
                        <Setter Target="ContentStack.MaxWidth" Value="440  "/>
                        <Setter Target="BrandIcon.Width" Value="52"/>
                        <Setter Target="BrandIcon.Height" Value="52"/>
                        <Setter Target="BrandTitle.FontSize" Value="34"/>
                        <Setter Target="BrandSubtitle.FontSize" Value="14"/>
                        <Setter Target="VaultTitle.FontSize" Value="36"/>
                        <Setter Target="VoiceCard.Padding" Value="22"/>
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContainer.Padding" Value="24,28,24,32"/>
                        <Setter Target="ContentStack.Width" Value="440"/>
                        <Setter Target="ContentStack.MaxWidth" Value="440"/>
                        <Setter Target="BrandIcon.Width" Value="60"/>
                        <Setter Target="BrandIcon.Height" Value="60"/>
                        <Setter Target="BrandTitle.FontSize" Value="42"/>
                        <Setter Target="BrandSubtitle.FontSize" Value="16"/>
                        <Setter Target="VaultTitle.FontSize" Value="46"/>
                        <Setter Target="VoiceCard.Padding" Value="32"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid x:Name="PageContainer" Padding="24,28,24,32">
                <StackPanel x:Name="ContentStack"
                        HorizontalAlignment="Center"
                        Width="440"
                        MaxWidth="440"
                        Spacing="22">

                    <!-- Branding + Heading -->
                    <StackPanel HorizontalAlignment="Center"
                            MaxWidth="440"
                            Spacing="14">

                        <StackPanel HorizontalAlignment="Center"
                                    Spacing="8">
                            <Border x:Name="BrandIcon"
                                    Width="60"
                                    Height="60"
                                    CornerRadius="18"
                                    Background="{ThemeResource AccentBrush}">
                                <Viewbox Margin="12">
                                    <TextBlock Text="🛡"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                </Viewbox>
                            </Border>

                            <TextBlock x:Name="BrandTitle"
                                       Text="GestureVault"
                                       FontSize="42"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource PrimaryTextBrush}"/>

                            <TextBlock x:Name="BrandSubtitle"
                                       Text="Secure multi-modal digital vault"
                                       FontSize="16"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center"
                                    Spacing="6"
                                    Margin="0,8,0,0">
                            <TextBlock x:Name="VaultTitle"
                                       Text="Voice Verification"
                                       FontSize="46"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource PrimaryTextBrush}"/>

                            <TextBlock Text="Step 2 of 3 • Speak your secret passphrase"
                                       FontSize="15"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>

                    </StackPanel>

                    <!-- Voice Verification Card -->
                    <Border x:Name="VoiceCard"
                            HorizontalAlignment="Stretch"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="28"
                            Padding="32">

                        <StackPanel Spacing="22">

                            <!-- Microphone Icon -->
                            <Border Width="110"
                                    Height="110"
                                    CornerRadius="55"
                                    Background="#EAF2FF"
                                    HorizontalAlignment="Center">
                                <Viewbox Margin="28">
                                    <TextBlock Text="🎙"/>
                                </Viewbox>
                            </Border>

                            <!-- Status Text -->
                            <StackPanel Spacing="6"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="VoiceStatusText"
                                           Text="Ready to listen"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           Foreground="{ThemeResource PrimaryTextBrush}"/>

                                <TextBlock x:Name="VoiceInstructionText"
                                           Text="Click Start Listening, then say your registered passphrase clearly."
                                           FontSize="14"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           MaxWidth="460"/>
                            </StackPanel>

                            <!-- Listening Visual -->
                            <Grid Height="70">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                    <Border Width="10"
                                            Height="24"
                                            CornerRadius="5"
                                            Background="{ThemeResource AccentBrush}"
                                            Opacity="0.35"/>
                                    <Border Width="10"
                                            Height="42"
                                            CornerRadius="5"
                                            Background="{ThemeResource AccentBrush}"
                                            Opacity="0.55"/>
                                    <Border Width="10"
                                            Height="58"
                                            CornerRadius="5"
                                            Background="{ThemeResource AccentBrush}"/>
                                    <Border Width="10"
                                            Height="42"
                                            CornerRadius="5"
                                            Background="{ThemeResource AccentBrush}"
                                            Opacity="0.55"/>
                                    <Border Width="10"
                                            Height="24"
                                            CornerRadius="5"
                                            Background="{ThemeResource AccentBrush}"
                                            Opacity="0.35"/>
                                </StackPanel>
                            </Grid>

                            <!-- Verification Status -->
                            <Border CornerRadius="18"
                                    BorderBrush="{ThemeResource InputBorderBrush}"
                                    BorderThickness="2"
                                    Background="{ThemeResource InputBackgroundBrush}"
                                    Padding="18,14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Status"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource SecondaryTextBrush}"/>

                                    <TextBlock x:Name="DetectedPhraseText"
                                               Text="Ready when you are."
                                               FontSize="16"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Main Action -->
                            <Button x:Name="StartListeningButton"
                                    Content="Start Listening"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Click="StartListeningButton_Click"/>

                            <TextBlock Text="or"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>

                            <!-- Back / Cancel -->
                            <Button x:Name="BackButton"
                                    Content="Back to Password Step"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="BackButton_Click"/>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
