<Window
    x:Class="GestureVault.RegistrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GestureVault – Setup">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppBackgroundBrush}"
          RequestedTheme="Light">

        <Grid.Resources>
            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="56"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{ThemeResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>
            <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="54"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource MutedButtonBorderBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource MutedButtonForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="16"/>
            </Style>
        </Grid.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="24,40,24,40">
                <StackPanel HorizontalAlignment="Center"
                            Width="560" MaxWidth="560"
                            Spacing="28">

                    <!-- ── Brand ───────────────────────────────────────────── -->
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <Border Width="64" Height="64" CornerRadius="20"
                                Background="{ThemeResource AccentBrush}"
                                HorizontalAlignment="Center">
                            <Viewbox Margin="14">
                                <TextBlock Text="🛡" Foreground="White" FontWeight="SemiBold"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="GestureVault"
                                   FontSize="40" FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource PrimaryTextBrush}"/>
                        <TextBlock Text="Let's get you set up"
                                   FontSize="16" TextAlignment="Center"
                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <!-- ── Step indicator ──────────────────────────────────── -->
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Step 1 dot -->
                        <Border x:Name="Step1Dot" Grid.Column="0"
                            Width="36" Height="36" CornerRadius="18"
                            Background="{ThemeResource AccentBrush}">
                            <TextBlock x:Name="Step1DotText" Text="1" FontSize="15" FontWeight="SemiBold"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <!-- Connector -->
                        <Border Grid.Column="1" Height="2" VerticalAlignment="Center"
                                Background="{ThemeResource CardBorderBrush}"/>
                        <!-- Step 2 dot -->
                        <Border x:Name="Step2Dot" Grid.Column="2"
                                Width="36" Height="36" CornerRadius="18"
                                Background="{ThemeResource CardBorderBrush}">
                            <TextBlock x:Name="Step2DotText" Text="2"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <!-- Connector -->
                        <Border Grid.Column="3" Height="2" VerticalAlignment="Center"
                                Background="{ThemeResource CardBorderBrush}"/>
                        <!-- Step 3 dot -->
                        <Border x:Name="Step3Dot" Grid.Column="4"
                            Width="36" Height="36" CornerRadius="18"
                            Background="{ThemeResource CardBorderBrush}">
                            <TextBlock x:Name="Step3DotText" Text="3"
                                FontSize="15" FontWeight="SemiBold"
                                Foreground="{ThemeResource SecondaryTextBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- ══════════════════════════════════════════════════════
                         STEP 1 — Master Password
                    ══════════════════════════════════════════════════════ -->
                    <StackPanel x:Name="Step1Panel" Spacing="22">

                        <StackPanel Spacing="4">
                            <TextBlock Text="Step 1 of 3 — Master Password"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock Text="This password encrypts your entire vault. Choose something strong — you'll need it every time you log in."
                                       FontSize="14" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <Border CornerRadius="24" Padding="28"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="20">

                                <!-- New Password -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="New Password"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                                    <Grid Height="60">
                                        <Grid.Resources>
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                        </Grid.Resources>
                                        <Border CornerRadius="16"
                                                BorderBrush="{ThemeResource InputBorderBrush}"
                                                BorderThickness="2"
                                                Background="{ThemeResource InputBackgroundBrush}"/>
                                        <TextBox x:Name="NewPasswordTextBox"
                                                 Visibility="Collapsed"
                                                 Height="28" Margin="18,0,60,0"
                                                 VerticalAlignment="Center"
                                                 BorderThickness="0" Background="Transparent"
                                                 Padding="0" FontSize="16"/>
                                        <PasswordBox x:Name="NewPasswordBox"
                                                     Height="28" Margin="18,0,60,0"
                                                     VerticalAlignment="Center"
                                                     BorderThickness="0" Background="Transparent"
                                                     Padding="0" FontSize="16"
                                                     PasswordRevealMode="Hidden"/>
                                        <Button x:Name="ToggleNewPasswordButton"
                                                Width="36" Height="36"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0"
                                                Background="Transparent" BorderThickness="0"
                                                Click="ToggleNewPassword_Click">
                                            <TextBlock x:Name="EyeIcon1" Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Confirm Password -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Confirm Password"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                                    <Grid Height="60">
                                        <Grid.Resources>
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                                        </Grid.Resources>
                                        <Border CornerRadius="16"
                                                BorderBrush="{ThemeResource InputBorderBrush}"
                                                BorderThickness="2"
                                                Background="{ThemeResource InputBackgroundBrush}"/>
                                        <TextBox x:Name="ConfirmPasswordTextBox"
                                                 Visibility="Collapsed"
                                                 Height="28" Margin="18,0,60,0"
                                                 VerticalAlignment="Center"
                                                 BorderThickness="0" Background="Transparent"
                                                 Padding="0" FontSize="16"/>
                                        <PasswordBox x:Name="ConfirmPasswordBox"
                                                     Height="28" Margin="18,0,60,0"
                                                     VerticalAlignment="Center"
                                                     BorderThickness="0" Background="Transparent"
                                                     Padding="0" FontSize="16"
                                                     PasswordRevealMode="Hidden"/>
                                        <Button x:Name="ToggleConfirmPasswordButton"
                                                Width="36" Height="36"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0"
                                                Background="Transparent" BorderThickness="0"
                                                Click="ToggleConfirmPassword_Click">
                                            <TextBlock x:Name="EyeIcon2" Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <TextBox x:Name="PasswordHintBox"
                                         Header="Password hint"
                                         PlaceholderText="Optional reminder for the password step"
                                         CornerRadius="12"/>

                                <!-- Password strength meter -->
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Password strength"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="StrengthLabel"
                                                   Grid.Column="1"
                                                   Text="—"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SecondaryTextBrush}"/>
                                    </Grid>
                                    <Grid Height="6" CornerRadius="3">
                                        <Border CornerRadius="3"
                                                Background="{ThemeResource CardBorderBrush}"/>
                                        <Border x:Name="StrengthBar"
                                                CornerRadius="3"
                                                HorizontalAlignment="Left"
                                                Width="0"
                                                Background="{ThemeResource AccentBrush}"/>
                                    </Grid>
                                </StackPanel>

                                <Button Content="Next →"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Click="Step1Next_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════════
                         STEP 2 — Voice Passphrase
                    ══════════════════════════════════════════════════════ -->
                    <StackPanel x:Name="Step2Panel" Spacing="22" Visibility="Collapsed">

                        <StackPanel Spacing="4">
                            <TextBlock Text="Step 2 of 3 — Voice Passphrase"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock Text="Choose a short phrase you'll speak aloud to verify your voice every time you unlock the vault."
                                       FontSize="14" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <Border CornerRadius="24" Padding="28"
                                Background="{ThemeResource CardBackgroundBrush}"
                                BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="20">

                                <!-- Passphrase input -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Your passphrase"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Use 3–6 words. Avoid personal info like birthdays or your name."
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{ThemeResource SecondaryTextBrush}"/>
                                    <Border CornerRadius="16" Height="60"
                                            BorderBrush="{ThemeResource InputBorderBrush}"
                                            BorderThickness="2"
                                            Background="{ThemeResource InputBackgroundBrush}">
                                        <TextBox x:Name="PassphraseBox"
                                                 PlaceholderText="e.g. open the blue garden gate"
                                                 BorderThickness="0" Background="Transparent"
                                                 Height="44" VerticalAlignment="Center" Padding="18,0" VerticalContentAlignment="Center"
                                                 FontSize="16"/>
                                    </Border>
                                </StackPanel>

                                <TextBox x:Name="PassphraseHintBox"
                                         Header="Passphrase hint"
                                         PlaceholderText="Optional reminder for the voice step"
                                         CornerRadius="12"/>

                                <!-- Hint box -->
                                <Border CornerRadius="14" Padding="16"
                                        Background="#EFF6FF"
                                        BorderBrush="#BFDBFE" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="💡 Tips for a good passphrase"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#1E40AF"/>
                                        <TextBlock Text="• Easy for you to say clearly and consistently"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Foreground="#1E3A8A"/>
                                        <TextBlock Text="• Hard for others to guess"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Foreground="#1E3A8A"/>
                                        <TextBlock Text="• Avoid single common words"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Foreground="#1E3A8A"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="← Back"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Click="Step2Back_Click"/>
                                    <Button Grid.Column="2" Content="Next →"
                                            Style="{StaticResource PrimaryActionButtonStyle}"
                                            Click="Step2Next_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══════════════════════════════════════════════════════════
                              STEP 3 — Gesture
                         ══════════════════════════════════════════════════════════ -->
                    <StackPanel x:Name="Step3Panel" Spacing="22" Visibility="Collapsed">

                        <StackPanel Spacing="4">
                            <TextBlock Text="Step 3 of 3 — Hand Gesture"
                                FontSize="22" FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryTextBrush}"/>
                            <TextBlock Text="Hold three hand signs in front of your camera to register them."
                                FontSize="14" TextWrapping="Wrap"
                                Foreground="{ThemeResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <Border CornerRadius="24" Padding="22"
                            Background="{ThemeResource CardBackgroundBrush}"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="20">

                                <!-- Camera preview area -->
                                <Border Height="260" CornerRadius="18"
                                    Background="#0F0F0F"
                                    BorderBrush="{ThemeResource AccentBrush}" 
                                    BorderThickness="2">
                                    <Grid>
                                        <!-- Live camera feed -->
                                        <Image x:Name="RegistrationCameraPreview"
                                            Stretch="Uniform"
                                            Height="260"/>

                                        <!-- Placeholder when camera is off -->
                                        <StackPanel x:Name="RegistrationCameraPlaceholder"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Spacing="12">
                                            <TextBlock Text="📷" FontSize="48"
                                                HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="RegistrationCameraStatus"
                                                Text="Click 'Start Camera' to begin"
                                                FontSize="15" FontWeight="SemiBold"
                                                TextAlignment="Center"
                                                Foreground="#1E40AF"/>
                                            <TextBlock Text="You'll hold steady hand signs in front of the camera"
                                                FontSize="13" TextWrapping="Wrap"
                                                TextAlignment="Center"
                                                Foreground="#9CA3AF"
                                                MaxWidth="280"/>
                                        </StackPanel>

                                        <!-- Scan corners overlay -->
                                        <Border Width="46" Height="46"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="12"
                                            BorderBrush="{ThemeResource AccentBrush}"
                                            BorderThickness="4,4,0,0"
                                            CornerRadius="8,0,0,0"/>
                                        <Border Width="46" Height="46"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="12"
                                            BorderBrush="{ThemeResource AccentBrush}"
                                            BorderThickness="0,4,4,0"
                                            CornerRadius="0,8,0,0"/>
                                        <Border Width="46" Height="46"
                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Margin="12"
                                            BorderBrush="{ThemeResource AccentBrush}"
                                            BorderThickness="4,0,0,4"
                                            CornerRadius="0,0,0,8"/>
                                        <Border Width="46" Height="46"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Margin="12"
                                            BorderBrush="{ThemeResource AccentBrush}"
                                            BorderThickness="0,0,4,4"
                                            CornerRadius="0,0,8,0"/>
                                    </Grid>
                                </Border>

                                <!-- Camera control button -->
                                <Button x:Name="StartRegistrationCameraButton"
                                    Content="📷 Start Camera"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Click="StartRegistrationCamera_Click"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="RedoRegistrationGestureButton"
                                        Grid.Column="0"
                                        Content="Previous Gesture"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        IsEnabled="False"
                                        Click="RedoRegistrationGesture_Click"/>
                                    <Button x:Name="NextRegistrationGestureButton"
                                        Grid.Column="2"
                                        Content="Next Gesture"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        IsEnabled="False"
                                        Click="NextRegistrationGesture_Click"/>
                                </Grid>

                                <!-- Detected gesture display -->
                                <Border CornerRadius="14" Padding="16"
                                    Background="{ThemeResource InputBackgroundBrush}"
                                    BorderBrush="{ThemeResource InputBorderBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Detected gesture"
                                            FontSize="13" FontWeight="SemiBold"
                                            Foreground="{ThemeResource SecondaryTextBrush}"/>
                                        <TextBlock x:Name="RegistrationDetectedGesture"
                                            Text="No gesture detected yet"
                                            FontSize="18" FontWeight="SemiBold"
                                            Foreground="{ThemeResource PrimaryTextBrush}"/>
                                        <TextBlock x:Name="RegistrationGestureInstruction"
                                            Text="Hold a clear sign: open hand, fist, or pointing finger"
                                            FontSize="13" TextWrapping="Wrap"
                                            Foreground="{ThemeResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Border>

                                <TextBox x:Name="GestureHintBox"
                                    Header="Gesture hint"
                                    PlaceholderText="Optional reminder for the gesture step"
                                    CornerRadius="12"/>

                                <!-- Recorded gesture -->
                                <Border x:Name="GestureRecordedBadge"
                                    CornerRadius="14" Padding="16"
                                    Background="#ECFDF5"
                                    BorderBrush="#6EE7B7" BorderThickness="2"
                                    Visibility="Collapsed">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="RecordedGestureText"
                                            FontSize="15" FontWeight="SemiBold"
                                            Foreground="#065F46"/>
                                        <TextBlock Text="✓ Gesture recorded successfully! You can continue."
                                            FontSize="13"
                                            Foreground="#047857"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="SkipGestureButton"
                                    Content="⏭ Skip (Demo Mode)"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Click="SkipGesture_Click"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="← Back"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Click="Step3Back_Click"/>
                                    <Button x:Name="FinishSetupButton"
                                        Grid.Column="2" 
                                        Content="Finish Setup"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        IsEnabled="False"
                                        Click="Step3Finish_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
